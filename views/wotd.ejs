<!DOCTYPE html>
<html>
<head>
    <title>Word of the Day</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <h1>Welcome to Jenil's Word of the Day</h1>

    <p>Every time you visit there will be a random word shown:</p>

    <p>Here is your word!</p>

    <p><strong><%= word %></strong> - <%= part %></p>

   <form method="GET" action="/words/wotd">
    <p>
        <label for="answer">Type the definition:</label>
        <input type="text" id="answer" name="answer">
        <button type="submit">Check Answer</button>
    </p>
</form>

<% if (typeof isCorrect !== 'undefined') { %>
    <p>
        <span class="<%= isCorrect ? 'correct' : 'incorrect' %>">
            <%= isCorrect ? 'Correct!' : 'Incorrect!' %>
        </span>
    </p>
<% } %>

<% if (isCorrect === false) { %>
    <p>
        Correct definition: <%= definition %>
    </p>
<% } %>

</body>
</html>